KEV_MCP_BIND_HOST=127.0.0.1
KEV_MCP_ALLOWED_HOSTS=localhost:8765,127.0.0.1:8765
KEV_API_KEY=replace-with-random-secret
# Set KEV_MCP_BIND_HOST to a LAN interface explicitly to allow other machines to connect.
# MCP authentication is optional; set a token before exposing this beyond loopback.
KEV_MCP_AUTH_TOKEN=
# Adapter-only mode; combined model mode uses the internal kev service instead.
KEV_API_BASE_URL=http://host.docker.internal:8008
KEV_RUN=jaredpalmer/kev-4b@139fdd94f1b6a6ad80cc15e08fcb99cac885a101
KEV_CACHE_VOLUME=docker_kev-hf-cache
HF_HUB_OFFLINE=1
